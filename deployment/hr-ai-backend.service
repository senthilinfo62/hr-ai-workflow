[Unit]
Description=HR AI Workflow Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/home/ubuntu/hr-ai-workflow/backend
Environment="PATH=/home/ubuntu/hr-ai-workflow/backend/venv/bin"
Environment="OPENAI_API_KEY=your_openai_api_key"
Environment="DB_HOST=localhost"
Environment="DB_USER=root"
Environment="DB_PASSWORD=admin@123"
Environment="DB_NAME=hr_ai"
ExecStart=/home/ubuntu/hr-ai-workflow/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
